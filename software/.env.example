# Public client configuration only. Never add HF_TOKEN or another secret here.
# Shipping builds use cloud Auto Select. Set this to your public Space identifier.
VITE_CHROMA_SAM_PROVIDER=cloud
VITE_CHROMA_SAM_SPACE=owner/chroma-sam3

# Development only: VITE_CHROMA_SAM_PROVIDER=local-sam3 selects the local SAM model.
# The on-device Auto engine is still available in all builds.
VITE_CHROMA_SAM3_URL=http://127.0.0.1:8001
